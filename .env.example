# Configuración pública de la aplicación web de Firebase. No pegar claves de servicio.
# Dejar vacío mantiene el juego local y las visitas desconectadas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Solo para desarrollo local; se ignora en una compilación de producción.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
